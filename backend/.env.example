# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-long-random-string

# Database (CHANGE the user/password/db name for your machine)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/planit_db
# Used only when running pytest (a separate database, never the dev DB)
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/planit_db_test

# JWT (CHANGE this to a long random string, different from SECRET_KEY)
JWT_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# Set to true once the app is served over HTTPS
JWT_COOKIE_SECURE=false

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000
