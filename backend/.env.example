# Flask
FLASK_ENV=development
FLASK_APP=run.py
SECRET_KEY=change-this-to-a-long-random-string

# Database (CHANGE the user/password/db name for your machine)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/planit_db
# Used only when running pytest (a separate database, never the dev DB)
TEST_DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/planit_db_test

# JWT (CHANGE this to a long random string, different from SECRET_KEY)
JWT_SECRET_KEY=change-this-to-a-different-long-random-string
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30
# Set to true once the app is served over HTTPS
JWT_COOKIE_SECURE=false

# CORS (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:3000

# X-Forwarded-For entries to trust for the visitor's IP. Next.js passes that header through as-is,
# so in production the reverse proxy in front of Next.js must overwrite it
# (nginx: proxy_set_header X-Forwarded-For $remote_addr;) and Flask must not be publicly reachable.
TRUSTED_PROXY_COUNT=1
# Rate-limit storage. memory:// is per process; use redis://host:6379 with several workers
RATELIMIT_STORAGE_URI=memory://

# Captcha (Cloudflare Turnstile by default; for hCaptcha or reCAPTCHA v2 also set CAPTCHA_VERIFY_URL).
# Empty = no check in development; production refuses forms until this is set.
CAPTCHA_SECRET_KEY=
# CAPTCHA_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

# Outgoing email for enquiry notifications (leave MAIL_SERVER empty to skip sending)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Comma-separated addresses that receive new enquiries
ENQUIRY_NOTIFY_TO=
