# Where the Next.js server reaches the Flask API (server-side fetches and the /api rewrite)
API_URL=http://localhost:5000

# Cloudflare Turnstile site key (public). Leave empty in development: no captcha widget is shown
# and the API skips the check. Pair it with CAPTCHA_SECRET_KEY in backend/.env.
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
